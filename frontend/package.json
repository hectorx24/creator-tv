{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:nav": "node --import tsx --test tests/nav-core.test.ts tests/chapters.test.ts",
    "test:dom": "node tests/tv-dom.test.mjs",
    "test": "npm run test:nav && npm run test:dom",
    "pretest:dom": "node tests/fixtures/build.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.16.0",
    "motion": "^14.0.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "^8.3.3"
  }
}
